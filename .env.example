APP_NAME="Logistics Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lms_db
DB_USERNAME=lms_user
DB_PASSWORD=secret

# ─────────────────────────────────────────
# Cache & Session
# ─────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─────────────────────────────────────────
# Queue
# ─────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0
REDIS_CACHE_DB=1

# ─────────────────────────────────────────
# Mail
# ─────────────────────────────────────────
# Gmail SMTP: isi username, App Password, dan alamat pengirim di environment.
# Jangan gunakan failover->log sebagai bukti email berhasil terkirim.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="you@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Akun Gmail dengan 2-Step Verification dan App Password:
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD="gmail-app-password-16-karakter"
# Production: APP_URL=https://domain-aplikasi-anda.example (URL publik HTTPS).
# MAIL_SCHEME=smtp + port 587 memakai STARTTLS; MAIL_ENCRYPTION tidak dibaca.
# Alternatif implicit TLS: MAIL_SCHEME=smtps, MAIL_PORT=465.
# Lihat docs/GMAIL_SMTP_SETUP.md untuk diagnosis jaringan dan verifikasi inbox.

# Mailpit hanya untuk pengujian lokal tanpa pengiriman ke inbox nyata:
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_REQUIRE_TLS=false

# Opsional, khusus Docker Desktop dengan jalur IPv6 yang berfungsi:
# COMPOSE_FILE=docker-compose.yml:compose.smtp-ipv6.yml

# ─────────────────────────────────────────
# Filesystem
# ─────────────────────────────────────────
FILESYSTEM_DISK=local

# ─────────────────────────────────────────
# Docker Ports
# ─────────────────────────────────────────
NGINX_PORT=8080
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@lms.com
PGADMIN_PASSWORD=admin123

# ─────────────────────────────────────────
# Sanctum
# ─────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080,127.0.0.1,::1

# ─────────────────────────────────────────
# API
# ─────────────────────────────────────────
API_VERSION=v1
API_RATE_LIMIT=60

# ─────────────────────────────────────────
# Reverb WebSocket (Realtime)
# ─────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
