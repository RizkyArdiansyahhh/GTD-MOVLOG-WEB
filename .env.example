APP_NAME="Logistics Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─────────────────────────────────────────
# Logging
# ─────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lms_db
DB_USERNAME=lms_user
DB_PASSWORD=secret

# ─────────────────────────────────────────
# Cache & Session
# ─────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─────────────────────────────────────────
# Queue
# ─────────────────────────────────────────
QUEUE_CONNECTION=redis

# ─────────────────────────────────────────
# Redis
# ─────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret
REDIS_DB=0
REDIS_CACHE_DB=1

# ─────────────────────────────────────────
# Mail
# ─────────────────────────────────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lms.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────
# Filesystem
# ─────────────────────────────────────────
FILESYSTEM_DISK=local

# ─────────────────────────────────────────
# Docker Ports
# ─────────────────────────────────────────
NGINX_PORT=8080
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@lms.local
PGADMIN_PASSWORD=admin123

# ─────────────────────────────────────────
# Sanctum
# ─────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8080,127.0.0.1,::1

# ─────────────────────────────────────────
# API
# ─────────────────────────────────────────
API_VERSION=v1
API_RATE_LIMIT=60
